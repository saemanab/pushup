<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:padding="24dp">
    
    <!-- Full-screen translucent background to dim background, and the actual dialog pop-up below -->
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_premium"
        android:padding="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Glowing Lock Icon -->
        <ImageView
            android:id="@+id/tvOverlayIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_glow"
            android:padding="16dp"
            android:src="@drawable/ic_lock_small"
            app:layout_constraintBottom_toTopOf="@id/tvOverlayHeadline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:tint="#FFFFFF" />

        <!-- Headline -->
        <TextView
            android:id="@+id/tvOverlayHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-large"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:text="APP BLOCKED"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvOverlayMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOverlayIcon" />

        <!-- Dynamic message -->
        <TextView
            android:id="@+id/tvOverlayMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="Complete your pushups\nto regain access to apps."
            android:textColor="#B3B3B3"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/btnOverlayReturn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOverlayHeadline" />

        <!-- Tap to return to app button -->
        <android.widget.Button
            android:id="@+id/btnOverlayReturn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_btn_purple"
            android:stateListAnimator="@null"
            android:text="Return to Workout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:elevation="6dp"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOverlayMessage" />
            
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>