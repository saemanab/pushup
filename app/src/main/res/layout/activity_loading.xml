<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_loading.xml — Premium "Building Your Plan" loading screen.
    Shown after quiz. Features:
      • Pulsing branded icon in a glow ring
      • Determinate gradient progress bar with % counter
      • Step-by-step checklist that ticks off one by one
      • Motivational footer copy
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- ── TOP: Branding headline ──────────────────────────────── -->
    <TextView
        android:id="@+id/tvHeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Building Your Plan"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubHeadline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Personalizing your push-up program\nbased on your answers…"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeadline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── CENTRE: Pulsing glow icon ───────────────────────────── -->
    <FrameLayout
        android:id="@+id/iconFrame"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubHeadline"
        app:layout_constraintBottom_toTopOf="@id/layoutSteps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Outer glow ring -->
        <View
            android:id="@+id/glowRing"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_icon_glow"
            android:alpha="0.5" />

        <!-- Icon -->
        <ImageView
            android:id="@+id/ivLoadingIcon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_dumbbell"
            app:tint="#FFFFFF" />

    </FrameLayout>

    <!-- ── STEPS checklist ──────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutSteps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/iconFrame"
        app:layout_constraintBottom_toTopOf="@id/progressContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <!-- Step 1 -->
        <LinearLayout
            android:id="@+id/step1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_step_item"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.3">

            <TextView
                android:id="@+id/tvStep1Check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="○"
                android:textColor="@color/purple_light"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Analyzing fitness profile"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStep1Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/purple_light"
                android:textSize="10sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:id="@+id/step2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_step_item"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.3">

            <TextView
                android:id="@+id/tvStep2Check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="○"
                android:textColor="@color/purple_light"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Setting up push-up counter"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStep2Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Engine"
                android:textColor="@color/purple_light"
                android:textSize="10sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:id="@+id/step3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_step_item"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.3">

            <TextView
                android:id="@+id/tvStep3Check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="○"
                android:textColor="@color/purple_light"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calibrating pose detection"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStep3Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera"
                android:textColor="@color/purple_light"
                android:textSize="10sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Step 4 -->
        <LinearLayout
            android:id="@+id/step4"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_step_item"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:alpha="0.3">

            <TextView
                android:id="@+id/tvStep4Check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="○"
                android:textColor="@color/purple_light"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Finalising your custom plan"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStep4Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done"
                android:textColor="@color/purple_light"
                android:textSize="10sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── BOTTOM: Progress bar + percentage ───────────────────── -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Label row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvCalibrationStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Getting started…"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProgressPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/purple_light"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Gradient progress bar -->
        <ProgressBar
            android:id="@+id/loadingProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_bar_gradient"
            android:indeterminate="false" />

        <!-- Motivational footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💪 Your personalized push-up journey starts now"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="14dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>