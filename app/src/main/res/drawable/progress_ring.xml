<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:innerRadiusRatio="2.4"
            android:shape="ring"
            android:thicknessRatio="18"
            android:useLevel="false">
            <solid android:color="@color/purple_dark" />
        </shape>
    </item>
    <item>
        <rotate
            android:fromDegrees="270"
            android:toDegrees="270">
            <shape
                android:innerRadiusRatio="2.4"
                android:shape="ring"
                android:thicknessRatio="18"
                android:useLevel="true">
                <gradient
                    android:angle="0"
                    android:endColor="@color/splash_gradient_bottom"
                    android:startColor="@color/splash_gradient_top"
                    android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>
