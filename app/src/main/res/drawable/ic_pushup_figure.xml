            Z
        " />

    <!--
        FOOT — clear toe/ball-of-foot shape at ground contact (left side).
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 14,149
            C 10,148 8,144 10,141
            C 12,138 18,137 24,139
            C 20,142 16,146 14,149
