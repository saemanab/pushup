<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_pushup_pro.xml
    Professional minimal push-up icon — pure stroke style.
    Side view, person in push-up DOWN position facing right.

    Design: thick rounded-cap bone lines + joint dots + head circle.
    All white. Viewport 96 × 60.

    Joint coordinates:
      HEAD   centre (78, 11)  r=9
      SHOULDER               (68, 22)
      ELBOW                  (73, 40)   ← arm bent DOWN and slightly forward
      HAND   (ground y=52)  (62, 52)
      HIP                    (28, 30)
      KNEE                   (14, 42)
      FOOT   (ground y=52)   (6,  52)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="192dp"
    android:height="120dp"
    android:viewportWidth="96"
    android:viewportHeight="60">

    <!-- ══  BACK LEG (far side, 45% opacity for depth) ══════════════════ -->
    <path
        android:strokeColor="#73FFFFFF"
        android:strokeWidth="3.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 30,31 L 17,43 L 10,53" />

    <!-- ══  BACK ARM (far side, 45% opacity) ═══════════════════════════ -->
    <path
        android:strokeColor="#73FFFFFF"
