<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_icon_badge.xml
    White circle with a subtle purple shadow — used as the
    premium icon badge behind the push-up logo on the splash screen.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow ring (neon purple, very soft) -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#339B59FF" />
        </shape>
    </item>

    <!-- White circle face -->
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>

</layer-list>