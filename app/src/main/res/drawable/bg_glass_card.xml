<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_glass_card.xml
    Glassmorphism frosted-glass card with neon blue border for the splash silhouette container.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Frosted glass fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#22FFFFFF" />  <!-- ~14% white -->
        </shape>
    </item>

    <!-- Neon blue border stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke
                android:width="1.5dp"
                android:color="#804FC3FF" />  <!-- 50% neon blue -->
        </shape>
    </item>

</layer-list>